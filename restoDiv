
.data
    msg1: .asciiz "\nDigite o primeiro numero: "
    msg2: .asciiz "\nDigite o segundo numero: "
    msg3: .asciiz "\nO resto da divisao e: "
    msg4: .asciiz "\nNao e permitido dividir por zero!"

.text
.globl main

main:
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 5
    syscall
    move $t1, $v0

    beq $t0, $zero, divisao_zero
    beq $t1, $zero, divisao_zero

    bgt $t0, $t1, dividir

    move $t2, $t0
    move $t0, $t1
    move $t1, $t2

dividir:
 
    div $t0, $t1
    mflo $t2

    mul $t3, $t2, $t1
    sub $t4, $t0, $t3

    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t4
    syscall

    j encerrar

divisao_zero:
    li $v0, 4
    la $a0, msg4
    syscall

encerrar:
    li $v0, 10
    syscall
